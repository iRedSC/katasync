{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "sh scripts/vercel-build.sh",
  "crons": [
    { "path": "/api/cron/sync/shopify?listings=1", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/sync/tiktok?listings=1", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/sync/ebay?listings=1", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/sync/amazon?listings=1", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/costs/shopify", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/costs/tiktok", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/costs/ebay", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/costs/amazon", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/tracking", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/inbox?sweep=1", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/inbox", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/orders/amazon", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/orders/ebay", "schedule": "*/5 * * * *" }
  ]
}
