{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "sh scripts/vercel-build.sh",
  "crons": [
    { "path": "/api/cron/sync/shopify?listings=1", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/sync/tiktok?listings=1", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/sync/ebay?listings=1", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/sync/amazon?listings=1", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/returns/shopify", "schedule": "2,17,32,47 * * * *" },
    { "path": "/api/cron/returns/tiktok", "schedule": "2,17,32,47 * * * *" },
    { "path": "/api/cron/returns/ebay", "schedule": "2,17,32,47 * * * *" },
    { "path": "/api/cron/returns/amazon", "schedule": "2,17,32,47 * * * *" },
    { "path": "/api/cron/costs/shopify", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/costs/tiktok", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/costs/ebay", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/costs/amazon", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/tracking", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/shippo-rebills", "schedule": "30 9 * * *" },
    { "path": "/api/cron/standing", "schedule": "30 */6 * * *" },
    { "path": "/api/cron/inbox?sweep=1", "schedule": "7 */4 * * *" },
    { "path": "/api/cron/inbox", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/messages?sweep=1", "schedule": "15 */4 * * *" },
    { "path": "/api/cron/messages", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/orders/amazon", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/orders/ebay", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/webhooks", "schedule": "*/5 * * * *" }
  ]
}
